// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Report {
  id            String   @id @default(uuid())
  name          String?        // optionnel
  city          String
  meterNumber   String
  userId        String
  meterId       String?
  billedAmount  Int            // montant facturé
  realAmount    Int            // montant réel
  reason   String
  fileUrl       String?        // facture importée
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  billId        String?
  type          String
  description   String
  hash          String
  txHash        String
  status        ComplaintStatus @default(PENDING)
  bill          Facture @relation(fields: [billId], references: [id])
}

model Testimonial {
  id              String   @id @default(uuid())
  name            String
  profession      String
  city            String
  realAmount      Int              // montant réel payé
  usualAmount     Int              // montant habituel
  problem         String           // type de problème
  description     String
  createdAt       DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  address   String
  nonce     String
  role      String  @default("USER") // admin, client
  createdAt DateTime @default(now())
  meters    Compteur[]
}

model Compteur {
  id        String   @id @default(uuid())
  numero    String   @unique
  userId    String?
  status    String
  response  String?
  user      User?     @relation(fields: [userId], references: [id])
  consumptions  Consommation[]
}

model Consommation {
  id          String   @id @default(uuid())
  compteurId  String
  valeurKwh   Float
  date        DateTime @default(now())
  userAddress String
  meter       Compteur  @relation(fields: [compteurId], references: [id])
  hash        String
  txHash      String
}

model Facture {
  id            String   @id @default(uuid())
  consommationId String
  montant       Float
  status       BillStatus @default(GENERATED) 
  hash          String?
  version       Int @default(1)
  isActive      Boolean @default(true)
  txHash        String?
  userId        String
  qrCode        String
   anomalyFlag   Boolean @default(false)
  anomalyScore   Float?
  createdAt     DateTime @default(now())
  meterId       String
  meter         Compteur @relation(fields: [meterId], references: [id])
  year          Int
  month         Int
  parentId      String?
  totalKwh      Float
  isCorrected   Boolean @default false

}

model Anomalie {
  id            String   @id @default(uuid())
  consommationId String
  type          String
  description   String?
  createdAt     DateTime @default(now())
  consumption   Consumption @relation(fields: [consumptionId], references: [id])
  hash          String?
  txHash        String?
  billId        String
  severity      String
  bill          Facture @relation(fields: [billId], references: [id])
}
model Alerte {
  id        String @id @default(uuid())
  meterId   String?
  type      String
  severity  String
  userId    String
  message   String
  seen      Boolean @default(false)
  createdAt DateTime @default(now())
}

enum BillStatus{
  GENERATED
  CORRECTED
}
